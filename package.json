{
  "name": "paytail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts & vite dev",
    "dev:web": "vite dev",
    "dev:api": "tsx watch src/server/index.ts",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "start:api": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/utils/*.test.ts src/server/*.test.ts",
    "slips:build": "swiftc -O tools/slip-reader/main.swift tools/slip-reader/Sources/*.swift -o tools/slip-reader/bin/slipreader",
    "slips:serve": "node --env-file-if-exists=.env tools/slip-reader/server.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/db/seed.ts",
    "db:reset": "node src/db/reset.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/drizzle-adapter": "^1.7.10",
    "@hono/node-server": "^2.1.5",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "^1.7.10",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.59.0",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "nitro": "3.0.260903-beta",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
