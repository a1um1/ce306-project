# Postgres (docker compose)
DATABASE_URL=postgres://paytail:paytail@localhost:5432/paytail

# Better Auth: public URL of the API, which serves /api/auth
# Google redirect URI: http://localhost:3001/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3001
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE Login (https://developers.line.biz/console/)
# Callback URL: http://localhost:3001/api/auth/callback/line
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Hono API server (own process)
API_PORT=3001
# Server-side base URL (SSR -> API)
API_URL=http://localhost:3001
# Browser-facing API base
VITE_API_URL=http://localhost:3001
# Web origin allowed by CORS / Better Auth
WEB_ORIGIN=http://localhost:3000

# Slip reader OCR service (macOS only; Apple Vision). Leave SLIP_READER_URL
# empty to run the OCR binary inside the API process.
SLIP_READER_URL=
SLIP_READER_PORT=4100
SLIP_READER_HOST=127.0.0.1
# Optional bearer token for the service (set the same value on both sides).
SLIP_READER_TOKEN=

# Keep every OCR read the importer would accept (import flow and reader test
# page), in tools/slip-reader/training/labels.jsonl as a training label.
# Off by default because it stores user slip photos.
SLIP_SAVE_READS=

# LINE Messaging API (https://developers.line.biz/console/). In dev, the tunnel
# script (bun run line:dev) publishes the API on a Cloudflare quick tunnel and
# points LINE at <tunnel>/api/line/webhook automatically.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
