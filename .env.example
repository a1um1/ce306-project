# Postgres (docker compose)
DATABASE_URL=postgres://paytail:paytail@localhost:5432/paytail

# Better Auth: public URL of the API, which serves /api/auth
# Google redirect URI: http://localhost:3001/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3001
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hono API server (own process)
API_PORT=3001
# Server-side base URL (SSR -> API)
API_URL=http://localhost:3001
# Browser-facing API base
VITE_API_URL=http://localhost:3001
# Web origin allowed by CORS / Better Auth
WEB_ORIGIN=http://localhost:3000
